{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install && npx playwright install chromium",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/spa-fallback.html"
    }
  ],
  "headers": [
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
